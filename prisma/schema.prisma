generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Multi-tenant (SaaS): cada "Agencia" es un inquilino aislado. TODO registro de
// datos lleva un `agencyId` y TODA consulta se filtra por la agencia del usuario
// logueado, de modo que una agencia NUNCA puede ver los datos de otra. Dentro de
// una misma agencia, todos los usuarios (admin/agente/asistente) comparten la
// cartera de clientes.
// ─────────────────────────────────────────────────────────────────────────────
model Agency {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Client {
  id                   String    @id @default(cuid())
  agencyId             String?   // Inquilino (agencia) dueño de este registro
  contractDate         DateTime?
  policyYear           Int?
  fullName             String
  ssn                  String?
  birthDate            DateTime?
  email                String?
  phone                String?
  filesTaxes           Boolean?  // ¿Declara impuestos?
  filingStatus         String?   // Soltero, Casado en conjunto, etc.
  maritalStatus        String?   // Estado civil
  employmentType       String?   // 1099 o W-2
  address              String?
  aptSuite             String?
  city                 String?
  zipCode              String?
  county               String?
  state                String?
  coverageType         String?
  insurer              String?
  affiliatesCount      Int?      @default(1)
  planName             String?
  planCategory         String?
  planId               String?
  // Plan benefits (filled via PDF extraction or manual edit)
  planNetwork          String?   // HMO, PPO, EPO, POS
  planDeductible       String?   // e.g. "$0" or "$3,200"
  planMaxOOP           String?   // e.g. "$8,700 individual"
  planPCP              String?   // Primary care: "$0 copay"
  planSpecialist       String?   // Specialist: "$40 copay"
  planUrgentCare       String?   // Urgent Care: "$75 copay"
  planHospital         String?   // Hospitalization: "20% coaseguro"
  planRxGeneric        String?   // Generic meds: "$3 copay"
  planXray             String?   // X-rays: "$45 copay"
  planCTScan           String?   // CT/PET/MRI: "20% coaseguro"
  planLab              String?   // Labs: "$30 copay"
  planReferral         String?   // Referral required: "Sí" / "No"
  acaPrice             Float?    @default(0)
  wnPolicies           String?
  // Washington National (WN) commission tracking — WN's contract date often
  // differs from the ACA contractDate (the WN ancillary policy may be added
  // later). cancellationDate lets us compute "months active" precisely for
  // clawback-risk purposes instead of using "today" for cancelled clients.
  wnContractDate          DateTime?
  cancellationDate        DateTime?
  // Manual overrides — WN's actual payment timing can differ from the
  // theoretical schedule (75% at submission / 25% after month 8). These let
  // the agent confirm what really happened instead of relying purely on dates.
  wnSecondPaymentReceived Boolean?  @default(false)
  wnClawbackReturned      Boolean?  @default(false)
  totalMonthly         Float?    @default(0)
  annualIncome         Float?
  status               String?   @default("Activo")
  activationDate       DateTime?   // 1st of month following contractDate
  renewalDate          DateTime?
  policyExpirationDate DateTime?
  preferredDoctors     String?
  specificMedications  String?
  bankHolder           String?
  bankName             String?
  bankRouting          String?
  bankAccount          String?
  bankAccountType      String?
  portalUser           String?
  portalPassword       String?
  sherpaUrl            String?
  googleReview         String?
  referralRequestStage    String?   // "Solicitado", "Recordatorio enviado", "Refirió", "No por ahora" (vacío/null = "Por enviar")
  referralRequestSentAt   DateTime?
  referralRequestLastSent DateTime?
  notes                String?
  preferredLanguage    String?   // Español, English
  dentalInsurer        String?
  dentalDeductible     String?
  dentalMaxBenefit     String?
  dentalMonthly        Float?    @default(0)
  firstPaymentPaid         Boolean?  @default(false)
  firstPaymentDate         DateTime?
  tags                     String?   // JSON array e.g. ["VIP","Necesita seguimiento"]
  applicantInPolicy        Boolean?  @default(true)
  applicantExclusionReason String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  dependents           Dependent[]
  appointments         Appointment[]
  activities           Activity[]
  policyHistory        PolicyHistory[]
  documents            Document[]
  commissionChecks     CommissionCheck[]
  insurerHistory       InsurerHistory[]

  @@index([agencyId])
  // Índices compuestos para las consultas más frecuentes (lista paginada
  // ordenada por nombre, filtro por estatus, y rangos de renovación en
  // dashboard/calendario/hoy) — mantienen la app rápida al crecer los datos.
  @@index([agencyId, fullName])
  @@index([agencyId, status])
  @@index([agencyId, renewalDate])
}

// Historial de cambios de aseguradora de un cliente (ej. tenía Oscar y se
// cambió a Ambetter en marzo). Permite que la conciliación de comisiones
// atribuya cada mes a la aseguradora que realmente aplicaba en ese período,
// en lugar de asumir siempre la aseguradora actual del cliente.
// startDate/endDate se guardan como el día 1 del mes (endDate = null significa
// "aseguradora actual", y el período posterior se cubre con client.insurer).
model InsurerHistory {
  id        String    @id @default(cuid())
  agencyId  String?
  clientId  String
  insurer   String
  startDate DateTime
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([agencyId])
}

model PolicyHistory {
  id           String   @id @default(cuid())
  agencyId     String?
  clientId     String
  year         Int
  insurer      String?
  planName     String?
  planCategory String?
  acaPrice     Float?
  totalMonthly Float?
  wnPolicies   String?
  notes        String?
  recordedAt   DateTime @default(now())
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}


model Dependent {
  id             String    @id @default(cuid())
  agencyId       String?
  clientId       String
  type           String
  name           String?
  birthDate      DateTime?
  ssn            String?
  inPolicy       Boolean?
  coverageNote   String?   // Medicaid, Medicare, CHIP, Otro
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

model Appointment {
  id        String   @id @default(cuid())
  agencyId  String?
  clientId  String
  date      DateTime
  notes     String?
  status    String   @default("Programada")
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

model Activity {
  id        String   @id @default(cuid())
  agencyId  String?
  clientId  String
  type      String
  content   String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

model CommissionRate {
  id                   String   @id @default(cuid())
  agencyId             String?
  insurer              String
  pmpm                 Float
  paymentDay           Int?     // Día del mes en que la aseguradora paga la comisión (1-31)
  // Meses entre la activación (o el cambio de aseguradora) y la primera
  // comisión pagada. Por defecto 2 (deber ser estándar), pero algunas
  // aseguradoras (ej. Oscar) pagan desde el mes siguiente a la activación (1).
  monthsToFirstPayment Int?     @default(2)
  notes                String?
  updatedAt            DateTime @updatedAt

  @@unique([agencyId, insurer])
  @@index([agencyId])
}

// Registro manual de pagos de comisión efectivamente recibidos, para comparar
// contra lo proyectado (PMPM × vidas) y ajustar las cifras a la realidad.
model CommissionPayment {
  id           String   @id @default(cuid())
  agencyId     String?
  insurer      String
  period       String   // Mes que cubre el pago, formato "YYYY-MM" (ej. "2026-04")
  amount       Float
  receivedDate DateTime
  notes        String?
  // Detalle por cliente cuando el pago se importó de un estado de cuenta:
  // JSON [{ clientId, name, amount }]. Permite expandir cada pago y ver qué
  // clientes incluyó y cuánto pagó cada uno.
  items        String?
  createdAt    DateTime @default(now())

  @@index([insurer, period])
  @@index([agencyId])
}

// Conciliación de comisiones: marca si la comisión de un cliente, para un mes
// (período) específico, ya fue confirmada como recibida. Se usa para comparar
// contra el total reportado en CommissionPayment y detectar qué cliente falta.
model CommissionCheck {
  id        String   @id @default(cuid())
  agencyId  String?
  clientId  String
  period    String   // "YYYY-MM"
  received  Boolean  @default(false)
  // Cuando un cliente esperado NO está en el pago, el motivo del faltante:
  // 'broker' (el broker lo pasó por alto, hay que reclamar) |
  // 'unpaid_premium' (el cliente no ha pagado su prima) |
  // 'cancelled' (el cliente canceló y se fue con otro agente) |
  // 'switched' (el cliente cambió de aseguradora) |
  // 'not_due' (todavía no corresponde el pago de ese cliente).
  // Permite darle seguimiento mes a mes.
  gapReason String?
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, period])
  @@index([period])
  @@index([agencyId])
}

// Eventos de calendario creados manualmente por el agente (no ligados
// necesariamente a un cliente), ej. recordatorios, reuniones, tareas.
model CalendarEvent {
  id        String   @id @default(cuid())
  agencyId  String?
  title     String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([agencyId])
}

model Document {
  id          String   @id @default(cuid())
  agencyId    String?
  clientId    String
  fileName    String   // original file name shown to user
  storedName  String   // UUID-based name on disk
  fileSize    Int      // bytes
  mimeType    String
  category    String   @default("Otro")
  notes       String?
  uploadedAt  DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

// Configuración por agencia (colores, marca, plantillas, llaves API, metas…).
// Antes la llave (`key`) era global; ahora es única POR agencia para que cada
// inquilino tenga su propia configuración aislada.
model Settings {
  id        String   @id @default(cuid())
  agencyId  String?
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([agencyId, key])
  @@index([agencyId])
}

model NotificationLog {
  id        String   @id @default(cuid())
  agencyId  String?
  type      String   // birthday, renewal, firstpayment
  refId     String   // clientId or date string
  sentAt    DateTime @default(now())

  @@unique([agencyId, type, refId])
  @@index([agencyId])
}

model Prospect {
  id                String   @id @default(cuid())
  agencyId          String?
  fullName          String
  phone             String?
  email             String?
  state             String?
  source            String?
  stage             String   @default("Nuevo Lead (Por Contactar)")
  notes             String?
  referredByClientId String?  // ID of the client who referred this prospect
  referredByName    String?  // Name cached for display
  assignedDate      DateTime @default(now())

  // ── "Modo Combate" — quick quoting fields captured live on the call ─────────
  zipCode           String?
  income            String?
  householdSize     String?

  // ── CMS / HealthSherpa compliance block ──────────────────────────────────────
  sherpaStatus      String?   // null | "enviado"
  consentAt         DateTime? // timestamp when client gave verbal/written consent

  // ── "En Espera de Decisión / Docs" — mandatory re-call scheduling ───────────
  callbackAt        DateTime? // agreed date/time to call the client back

  // ── "Cerrado - Perdido" — standardized loss tracking ─────────────────────────
  lossReason        String?   // GHOSTING | FALTA_DOCUMENTACION | PRECIO_INGRESOS | COMPETENCIA
  tags              String?   // JSON array, e.g. ["Nutrición"]

  // ── Auto-scheduled follow-up (e.g. Open Enrollment reopening on Nov 1) ──────
  followUpAt        DateTime?
  followUpNote      String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([agencyId])
}

model User {
  id        String   @id @default(cuid())
  agencyId  String?
  email     String   @unique
  name      String
  password  String
  role      String   @default("agent")   // admin, agent, assistant
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agency    Agency?  @relation(fields: [agencyId], references: [id])

  @@index([agencyId])
}

// Limitador de intentos de login persistente (reemplaza el rate-limit en memoria,
// que es inútil en serverless porque se reinicia en cada cold-start). Registra
// intentos fallidos por identificador (IP/email) con ventana y bloqueo temporal.
model LoginAttempt {
  id          String   @id @default(cuid())
  identifier  String   @unique // IP o email normalizado
  count       Int      @default(0)
  firstAt     DateTime @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime @updatedAt
}

// Registro de auditoría: quién hizo qué y cuándo. Cada acción sensible (crear/
// editar/borrar clientes, documentos, usuarios; exportar/respaldar datos; login)
// deja una huella inmutable, aislada por agencia. Indispensable para vender el
// CRM (cumplimiento y trazabilidad de datos personales).
model AuditLog {
  id          String   @id @default(cuid())
  agencyId    String?
  userId      String?
  userName    String?  // nombre del usuario, cacheado para mostrar
  userEmail   String?
  action      String   // create | update | delete | export | backup | login
  entity      String   // client | document | user | prospect | commissionPayment | session | data
  entityId    String?
  entityLabel String?  // etiqueta legible (ej. nombre del cliente)
  metadata    String?  // JSON opcional con contexto extra
  ip          String?
  createdAt   DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([agencyId, entity, entityId])
}
